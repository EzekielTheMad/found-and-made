{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "server/**/*",
    "src/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "#server/*": ["./server/*"],
      "#src/*": ["./src/*"],
      "~/*": ["./app/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client", "vitest/globals"]
  }
}
