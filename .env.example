DATA_DIR=.data
HOST=127.0.0.1
PORT=3000
# Optional Google OIDC. Both values are required to enable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP password recovery. SMTP_HOST and SMTP_FROM enable the feature.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional hosted or local OpenAI-compatible recipe-structuring provider.
# BASE_URL and MODEL must be supplied together; API_KEY is optional for local providers.
IMPORT_OPENAI_BASE_URL=
IMPORT_OPENAI_MODEL=
IMPORT_OPENAI_API_KEY=
# Optional transcription model for audio/video uploads. Image extraction uses
# IMPORT_OPENAI_MODEL; text-based PDFs are extracted locally before any model call.
IMPORT_OPENAI_TRANSCRIPTION_MODEL=

# Optional read-only Hermes MCP endpoint. Disabled unless all required controls
# are set. Configure Hermes to send the exact Origin value along with its
# clear-once Bearer token. Keep the endpoint LAN/VPN-bound; CIDRs are optional.
MCP_ENABLED=false
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_CIDRS=
MCP_REQUEST_RATE_LIMIT=120
# Absolute browser-facing origin used for canonical, social, invitation, and
# authentication URLs. Do not include a path. Use HTTPS for public deployments.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Production HTTP is rejected unless this explicit local-only override is set.
ALLOW_INSECURE_PUBLIC_ORIGIN=false

# Optional comma-separated proxy addresses/CIDRs. Forwarded client addresses
# are ignored unless the direct peer matches one of these explicit ranges.
TRUSTED_PROXY_RANGES=
