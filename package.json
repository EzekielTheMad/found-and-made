{
  "name": "found-and-made",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "db:generate": "drizzle-kit generate",
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env --conditions development server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "vitest",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node scripts/run-e2e-suite.mjs",
    "test:e2e:built:smoke": "node scripts/run-e2e.mjs tests/e2e/recipe-core.spec.ts",
    "test:e2e:spec": "node scripts/run-e2e.mjs",
    "test:run": "vitest run",
    "typecheck": "react-router typegen && tsc -b",
    "verify:server": "node scripts/verify-built-server.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "verify:container:amd64": "cross-env CONTAINER_VERIFY_ARM64=false node scripts/verify-container.mjs",
    "verify:container:remote": "node scripts/verify-remote-container.mjs",
    "verify:https-proxy": "node scripts/verify-https-proxy.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "better-auth": "1.6.25",
    "better-sqlite3": "12.11.1",
    "compression": "1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "fflate": "0.8.2",
    "file-type": "22.0.1",
    "isbot": "5.2.1",
    "nodemailer": "9.0.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "sharp": "0.35.3",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "selfsigned": "5.5.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
